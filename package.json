{
  "name": "twinsites",
  "version": "1.0.0",
  "description": "Find the vibe-coded websites that look like yours. Comparison runs entirely in the browser.",
  "license": "MIT",
  "author": "Ana Gui (https://github.com/AnaGuiDev)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --import tsx scripts/precompute-explore.ts && node --import tsx scripts/report-data.ts && node --import tsx scripts/embeddings-f16.ts && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test:worker": "node --import tsx --test worker/test/*.test.ts",
    "dataset": "tsx scripts/build-dataset.ts",
    "dataset:capture": "tsx scripts/capture.ts",
    "dataset:embed": "tsx scripts/embed.ts",
    "dataset:project": "node --import tsx scripts/project.ts",
    "dataset:calibrate": "tsx scripts/refresh-meta.ts",
    "dataset:mosaic": "tsx scripts/mosaic.ts",
    "dataset:layout": "tsx scripts/refresh-layout.ts",
    "dataset:distinct": "tsx scripts/distinct.ts",
    "dataset:copy": "tsx scripts/catalog-copy.ts",
    "typecheck": "tsc --noEmit",
    "qa": "VITE_SHOT_ENDPOINT=https://twinsites-shot.twinsites.workers.dev VITE_TURNSTILE_SITEKEY=1x00000000000000000000AA npm run build && tsx scripts/qa-analyzer.ts",
    "dataset:report": "tsx scripts/report-data.ts",
    "weight": "tsx scripts/weight.ts",
    "reliability": "tsx scripts/reliability.ts",
    "test:product": "node --import tsx --test test/*.test.ts",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "model:lab": "TWINSITES_MODEL_LAB=1 vite",
    "model:finalize": "node --import tsx scripts/finalize-model.ts",
    "model:evaluate": "node --import tsx scripts/evaluate-pairs.ts",
    "model:prepare": "node scripts/prepare-model.mjs",
    "pretest:product": "npm run model:prepare",
    "prebuild": "npm run model:prepare",
    "quality:catalog": "node --import tsx scripts/audit-catalog.ts",
    "quality:robustness": "npm run model:prepare && node --import tsx scripts/benchmark-robustness.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@huggingface/transformers": "3.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "ml-matrix": "^6.12.1",
    "playwright": "^1.56.0",
    "sharp": "^0.34.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "umap-js": "^1.4.0",
    "vite": "^7.1.5"
  }
}
