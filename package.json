{
  "name": "twinsites",
  "version": "1.0.0",
  "description": "Find the vibe-coded websites that look like yours. Comparison runs entirely in the browser.",
  "license": "MIT",
  "author": "Ana Gui (https://github.com/AnaGuiDev)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/precompute-explore.ts && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test:worker": "tsx --test worker/test/*.test.ts",
    "dataset": "tsx scripts/build-dataset.ts",
    "dataset:capture": "tsx scripts/capture.ts",
    "dataset:embed": "tsx scripts/embed.ts",
    "dataset:project": "tsx scripts/project.ts",
    "dataset:calibrate": "tsx scripts/refresh-meta.ts",
    "dataset:mosaic": "tsx scripts/mosaic.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@huggingface/transformers": "3.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "ml-matrix": "^6.12.1",
    "playwright": "^1.56.0",
    "sharp": "^0.34.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "umap-js": "^1.4.0",
    "vite": "^7.1.5"
  }
}
